{erl_opts, [debug_info]}.

{deps, [{poolboy, {git, "https://github.com/SiftLogic/poolboy.git", {branch, "feat/resize-pool"}}}]}.

{profiles,
 [{dev, []},
  {prod, []}]}.

%% Xref configuration - disable warnings about unused public API functions
%% This allows exported functions to exist without being called internally
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% Build hooks for Rust binary compilation
%% Uses GCC 11 to ensure C++ ABI compatibility with ONNX Runtime
{pre_hooks,
 [{"(linux|darwin|win32)", compile, 
   "bash -c 'cd native_gliner_worker && CC=gcc-11 CXX=g++-11 cargo build --release'"}]}.

%% Post-hook to copy binary for development/testing
%% (Release overlay handles this for production releases)
{post_hooks,
 [{"(linux|darwin|win32)", compile,
   "bash -c 'mkdir -p priv/bin && cp native_gliner_worker/target/release/native_gliner_worker priv/bin/native_gliner_worker || true'"}]}.

%% Release configuration
{relx, [{release, {gliner, "1.0.0"},
         [gliner_server]},
        {mode, prod},
        {include_erts, false},
        {extended_start_script, true},
        %% Copy native binary into release priv directory
        {overlay, [
            {copy, "native_gliner_worker/target/release/native_gliner_worker",
                   "lib/gliner_server/priv/bin/native_gliner_worker"}
        ]}]}.

%% Test configuration
{alias, [{test, [eunit, ct]}]}.

{eunit_opts, [verbose]}.
{ct_opts, [
    {dir, "tests"}
]}.
